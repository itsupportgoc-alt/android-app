<?xml version="1.0" encoding="utf-8"?>
<!--
  DevWord launcher icon — monochrome layer (Android 13+ themed icons).

  Only the alpha channel matters here (the system tints it), so the page is drawn as an outline
  with its fold crease and text lines rather than as a solid fill — a filled sheet would collapse
  into one blank blob once tinted.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Page outline. -->
    <path
        android:pathData="M38,26 H62 L74,38 V75 A6,6 0 0 1 68,81 H38 A6,6 0 0 1 32,75 V32 A6,6 0 0 1 38,26 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- Fold crease. -->
    <path
        android:pathData="M62,26 V38 H74"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- Text lines. -->
    <path
        android:pathData="M41,48 H65"
        android:strokeColor="#FF000000"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M41,58 H65"
        android:strokeColor="#FF000000"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M41,67 H55"
        android:strokeColor="#FF000000"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
</vector>
