<?xml version="1.0" encoding="utf-8"?>
<!--
  DevWord launcher icon — background layer.

  A deep blue diagonal gradient (Word's chrome blue down to a near-navy corner) with a soft
  light band across the lower right, so the plate has depth and reads as a designed tile rather
  than a flat fill under every launcher mask (circle, squircle, rounded square). The white page
  with its magenta fold lives in the foreground layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF3170C9"
                    android:offset="0" />
                <item
                    android:color="#FF1B4C93"
                    android:offset="0.55" />
                <item
                    android:color="#FF102C58"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Depth: a translucent light band running through the lower right. -->
    <path
        android:pathData="M54,108 L108,54 L108,108 Z"
        android:fillColor="#12FFFFFF" />
</vector>
