<?xml version="1.0" encoding="utf-8"?>
<!--
  DevWord launcher icon — background layer.

  A pink diagonal gradient (light pink -> deep pink) fills the whole 108dp adaptive-icon
  canvas, so the icon reads as pink under every launcher mask (circle, squircle, rounded
  square). The white "DW" monogram lives in the foreground layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF7FB3"
                    android:offset="0" />
                <item
                    android:color="#E91E63"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
